##########         QUESTION API CALLS             ######


#api call for adding question
###
POST http://127.0.0.1:8000/problem/assessment/2/question/
Content-Type: application/json
Authorization:Token e4822ddbffe88ae7af59f728948dd75958eda5bf

{
    "title":"product",
    "description":"write a pgm to find product of 2 numbers",
    "score":50,
    "sample_input":"A=20,B=10",
    "sample_output":"result=200"
    
}


#api call to fetch a question
###
GET http://127.0.0.1:8000/problem/question/4/
Accept: application/json
Authorization:Token e4822ddbffe88ae7af59f728948dd75958eda5bf






#  ==========       SUBMISSION API CALLS    ==================


#api call for submission
###
POST http://127.0.0.1:8000/evaluation/assessment/2/submission/
Content-Type: application/json
Authorization: 

{
    "question":5,
    "answer_text":"print('hello world')"
}


#api call for fetching submission detail
###
GET http://127.0.0.1:8000/evaluation/submission/1/
Accept: application/json
Authorization: Token e4822ddbffe88ae7af59f728948dd75958eda5bf


#api call for evaluating answer(updating answer)
###
PATCH http://127.0.0.1:8000/evaluation/answer/1/
Content-Type: application/json
Authorization: Token e4822ddbffe88ae7af59f728948dd75958eda5bf

{
    "marks_awarded":130,
    "feedback":"entire logic wrong"
}